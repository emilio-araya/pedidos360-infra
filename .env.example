# ============================================
# Pedidos360 — Variables de entorno
# ============================================

# --- Base de datos Oracle ---
ORACLE_PASSWORD=change-me-in-production
ORACLE_DATABASE=FREEPDB1
CATALOG_DB_USERNAME=catalog_user
CATALOG_DB_PASSWORD=change-me-in-production
ORDERS_DB_USERNAME=orders_user
ORDERS_DB_PASSWORD=change-me-in-production

# --- RabbitMQ (eventos de stock) ---
RABBITMQ_USERNAME=pedidos360
RABBITMQ_PASSWORD=change-me-in-production
RABBITMQ_VHOST=pedidos360
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_2_MANAGEMENT_PORT=15673
# Shared secret of the two cluster nodes: any long random string, same on both.
RABBITMQ_ERLANG_COOKIE=change-me-to-a-long-random-string
# Messaging admin API (loopback only).
MESSAGING_ADMIN_PORT=8085

# --- Kafka (eventos de dominio de pedido) ---
# Interfaz web de Kafka UI (sólo loopback).
KAFKA_UI_PORT=8086
# Identificador del cluster KRaft: UUID base64 de 22 caracteres.
# Generar uno propio con: docker run --rm apache/kafka:4.3.2 /opt/kafka/bin/kafka-storage.sh random-uuid
# Si se cambia con el volumen kafka-data ya creado, el broker no arranca: borrar el volumen antes.
KAFKA_CLUSTER_ID=lt4pMihWTs2WdoOIy9jBqg

# --- Correo del voucher de invitado ---
# Local: Mailpit (SMTP interno en mailpit:1025, interfaz en 127.0.0.1:8025).
# AWS: las mismas variables apuntan al SMTP de Amazon SES.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@pedidos360.local
MAILPIT_UI_PORT=8025
# Base del enlace de seguimiento que viaja en el correo.
FRONTEND_PUBLIC_URL=http://localhost:4200

# --- Microsoft Entra ID ---
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_API_AUDIENCE=your-api-client-id
API_SCOPE=api://150f51db-4084-4979-b1a1-e6a6e7893a01/access_as_user
API_BASE_URL=http://localhost:8080
REDIRECT_URI=http://localhost:4200/login
POST_LOGOUT_REDIRECT_URI=http://localhost:4200/login

# --- Amazon Cognito (segunda cadena del backend, sin uso desde la SPA) ---
COGNITO_USER_POOL_ID=us-east-1_UmEhPRYdI
COGNITO_USER_POOL_CLIENT_ID=59be26pgg5ginu2sutr8eetgjg
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_UmEhPRYdI
COGNITO_API_AUDIENCE=59be26pgg5ginu2sutr8eetgjg

# --- Puertos locales ---
BFF_PORT=8080
FRONTEND_PORT=4200

# --- WireMock (desarrollo local) ---
WIREMOCK_PORT=8089
ENTRA_ISSUER=http://localhost:8089
ENTRA_JWK_SET_URI=http://localhost:8089/discovery/v2.0/keys

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
